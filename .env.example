# Somente no servidor. Nunca prefixar DATABASE_URL com VITE_.
DATABASE_URL=postgresql://USER:PASSWORD@POOLED_HOST/neondb?sslmode=verify-full
NEON_AUTH_BASE_URL=https://YOUR_BRANCH/neondb/auth
# Público: endpoint de identidade, não é um segredo.
VITE_NEON_AUTH_URL=https://YOUR_BRANCH/neondb/auth

# Mercado Pago: inject secrets securely; never use VITE_ prefixes for these values.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_COLLECTOR_ID=
MP_MODE=
MP_APP_ORIGIN=https://fazendinha-wj.vercel.app
MP_TEST_CHECKOUT_ENABLED=false
MP_ACCOUNT_VERIFIED=false
MP_SANDBOX_VALIDATED=false
MP_FEES_ACKNOWLEDGED=false
MP_SALES_ENABLED=false
