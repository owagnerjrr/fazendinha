{
  "framework": "vite",
  "buildCommand": "npm test && npm run build",
  "outputDirectory": "dist",
  "regions": [
    "iad1"
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth?path=:path*"
    }
  ],
  "functions": {
    "api/store.ts": {
      "maxDuration": 60
    },
    "api/mp-webhook.ts": {
      "maxDuration": 60
    },
    "api/mp-reconcile.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/mp-reconcile",
      "schedule": "0 6 * * *"
    }
  ]
}
